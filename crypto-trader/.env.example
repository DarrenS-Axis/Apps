# Crypto.com EXCHANGE API credentials.
#
# These come from the Exchange (crypto.com/exchange), NOT the Crypto.com App.
# Create them at:  Exchange -> Settings -> API Keys
#
# When you create the key:
#   - Enable "Trading" only. Leave WITHDRAWALS DISABLED. Nothing in this program
#     withdraws, so a key that cannot withdraw cannot be used to drain the account
#     even if it leaks.
#   - Restrict it to your IP address if your connection has a stable one.
#
CDC_API_KEY=
CDC_API_SECRET=

# Live trading is off unless this is set to exactly I_ACCEPT_THE_RISK.
# Leave it blank or remove the line to keep the bot in paper mode.
CDC_LIVE_CONFIRM=

# Set to 1 for full stack traces on errors.
CDC_DEBUG=
