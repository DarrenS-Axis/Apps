{
  "name": "hydraulic-itp-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first field app for managing hydraulic services Inspection & Test Plans (ITPs)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "smoke": "node tests/smoke-core.mjs && node tests/smoke-evidence.mjs && node tests/smoke-offline.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
